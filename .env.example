# pipeline/collectors/*(Stage A, 수집)에서만 사용하는 API 키.
# 이 파일을 .env로 복사한 뒤 실제 키를 채워 넣는다. .env는 .gitignore에
# 이미 포함되어 있어 커밋되지 않는다.

# YouTube Data API v3 키 — https://console.cloud.google.com 에서
# 프로젝트 생성 후 "YouTube Data API v3"를 사용 설정하고 발급받는다.
YOUTUBE_API_KEY=

# OpenDART(금융감독원 전자공시시스템) API 키 — https://opendart.fss.or.kr
# 에서 가입 후 무료로 발급받는다.
DART_API_KEY=
